# =========================================================
# HMS STAGING ENVIRONMENT
# =========================================================
# This file is safe to commit because it contains placeholders
# only.
#
# The real staging environment file will live on the VPS and
# MUST NOT be committed to Git.
# =========================================================
# Docker image version deployed to staging.
# In CI/CD this will normally be a Git commit SHA.
HMS_IMAGE_TAG=<GIT_COMMIT_SHA>

# Host-only port used by Caddy to reach the staging API.
HMS_API_HOST_PORT=18082

# ---------------------------------------------------------
# Spring Boot
# ---------------------------------------------------------

SPRING_PROFILES_ACTIVE=prod

HMS_BACKEND_PORT=8081


# ---------------------------------------------------------
# Public HMS URLs / CORS
# ---------------------------------------------------------

HMS_ALLOWED_ORIGINS=https://hms-staging.kivuadvisory.com


# ---------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------

HMS_JWT_SECRET=<GENERATE_A_STRONG_STAGING_JWT_SECRET>

HMS_JWT_ISSUER=hotel-management-api-staging

HMS_JWT_ACCESS_TOKEN_MINUTES=15
HMS_JWT_REFRESH_TOKEN_DAYS=30

HMS_AUTH_REQUESTS_PER_MINUTE=30
HMS_AUTH_MAX_FAILED_ATTEMPTS=5
HMS_AUTH_LOCK_MINUTES=15


# ---------------------------------------------------------
# PostgreSQL / Neon
# ---------------------------------------------------------
# Paste the actual Neon JDBC connection string in the real
# staging environment file on the VPS.
#
# Example shape only:
# jdbc:postgresql://<neon-host>/<database>?<secure-options>

HMS_DB_URL=<PASTE_NEON_STAGING_JDBC_URL_HERE>

HMS_DB_USER=<NEON_STAGING_DATABASE_USER>

HMS_DB_PASSWORD=<NEON_STAGING_DATABASE_PASSWORD>

HMS_DB_MAX_POOL_SIZE=10
HMS_DB_MIN_IDLE=2


# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

HMS_REDIS_HOST=redis
HMS_REDIS_PORT=6379

HMS_REDIS_PASSWORD=<GENERATE_A_STRONG_STAGING_REDIS_PASSWORD>


# ---------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------

HMS_RABBITMQ_HOST=rabbitmq
HMS_RABBITMQ_PORT=5672

HMS_RABBITMQ_USERNAME=hms_staging
HMS_RABBITMQ_PASSWORD=<GENERATE_A_STRONG_STAGING_RABBITMQ_PASSWORD>