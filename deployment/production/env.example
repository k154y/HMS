# =========================================================
# HMS PILOT PRODUCTION ENVIRONMENT
# =========================================================

SPRING_PROFILES_ACTIVE=prod

# Docker image version deployed to production.
# Later this will be an immutable Git commit SHA.
HMS_IMAGE_TAG=<GIT_COMMIT_SHA>

# Spring Boot port inside Docker.
HMS_BACKEND_PORT=8081


# =========================================================
# Frontend / CORS
# =========================================================

HMS_ALLOWED_ORIGINS=https://hms.kivuadvisory.com


# =========================================================
# JWT / Authentication
# =========================================================

# Generate a NEW production-only secret:
# openssl rand -hex 32
HMS_JWT_SECRET=<GENERATE_PRODUCTION_JWT_SECRET>

HMS_JWT_ISSUER=hotel-management-api-production
HMS_JWT_ACCESS_TOKEN_MINUTES=15
HMS_JWT_REFRESH_TOKEN_DAYS=30

HMS_AUTH_REQUESTS_PER_MINUTE=30
HMS_AUTH_MAX_FAILED_ATTEMPTS=5
HMS_AUTH_LOCK_MINUTES=15


# =========================================================
# Neon PostgreSQL - PRODUCTION
# =========================================================

# IMPORTANT:
# This must point to the future HMS PRODUCTION Neon project.
# Never use the staging database here.
#
# Username/password are stored separately.
HMS_DB_URL=<PRODUCTION_NEON_JDBC_DIRECT_URL>
HMS_DB_USER=<PRODUCTION_NEON_USER>
HMS_DB_PASSWORD=<PRODUCTION_NEON_PASSWORD>

# Conservative pool sizing for the pilot VPS.
HMS_DB_MAX_POOL_SIZE=8
HMS_DB_MIN_IDLE=2


# =========================================================
# Redis - PRODUCTION
# =========================================================

HMS_REDIS_HOST=redis
HMS_REDIS_PORT=6379
HMS_REDIS_PASSWORD=<GENERATE_PRODUCTION_REDIS_PASSWORD>


# =========================================================
# RabbitMQ - PRODUCTION
# =========================================================

HMS_RABBITMQ_HOST=rabbitmq
HMS_RABBITMQ_PORT=5672
HMS_RABBITMQ_USERNAME=hms_production
HMS_RABBITMQ_PASSWORD=<GENERATE_PRODUCTION_RABBITMQ_PASSWORD>


# =========================================================
# Monitoring
# =========================================================

# Temporary during the pilot.
# Prometheus actuator remains available, but do not repeatedly
# send OTLP metrics to localhost when no collector is running.
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false