# ============================================================
# HOTEL MANAGEMENT SYSTEM
# Environment Variables Example
# ============================================================
#
# Never place real production secrets in this file.
# Production secrets must be supplied through environment
# variables or a secure secret-management system.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

HMS_APP_NAME=hotel-management-system

HMS_BACKEND_PORT=8080

HMS_FRONTEND_URL=http://localhost:3000

HMS_BACKEND_URL=http://localhost:8080


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

HMS_DB_HOST=localhost

HMS_DB_PORT=5432

HMS_DB_NAME=hotel_hms

HMS_DB_USER=hotel_hms_user

HMS_DB_PASSWORD=hotel_hms_password


# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

HMS_REDIS_HOST=localhost

HMS_REDIS_PORT=6379

HMS_REDIS_PASSWORD=


# ------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------

HMS_RABBITMQ_HOST=localhost

HMS_RABBITMQ_PORT=5672

HMS_RABBITMQ_USERNAME=hotel_hms_user

HMS_RABBITMQ_PASSWORD=hotel_hms_password


# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------

HMS_JWT_SECRET=
# Required: supply at least 32 random bytes. Never use this file for production secrets.
HMS_JWT_ISSUER=hotel-management-api
HMS_AUTH_MAX_FAILED_ATTEMPTS=5
HMS_AUTH_LOCK_MINUTES=15
HMS_AUTH_REQUESTS_PER_MINUTE=30
HMS_ALLOWED_ORIGINS=http://localhost:3000

HMS_JWT_ACCESS_TOKEN_MINUTES=15

HMS_JWT_REFRESH_TOKEN_DAYS=30


# ------------------------------------------------------------
# File Storage
# ------------------------------------------------------------
#
# The first cloud storage implementation will use
# Cloudflare R2.
#
# The architecture will remain compatible with AWS S3.
# ------------------------------------------------------------

HMS_STORAGE_PROVIDER=r2

HMS_R2_ENDPOINT=

HMS_R2_ACCESS_KEY_ID=

HMS_R2_SECRET_ACCESS_KEY=

HMS_R2_BUCKET=

HMS_R2_PUBLIC_URL=


# ------------------------------------------------------------
# OpenTelemetry
# ------------------------------------------------------------

HMS_OTEL_SERVICE_NAME=hotel-management-api

HMS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


# ------------------------------------------------------------
# Spring Profile
# ------------------------------------------------------------

SPRING_PROFILES_ACTIVE=dev
